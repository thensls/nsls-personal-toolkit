<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Person-intelligence biweekly sweep — macOS launchd agent.

  Install:
    1. Replace every /Users/YOUR_USERNAME below with your home directory.
    2. Confirm your claude path:      which claude   (PATH below must contain its dir)
    3. cp this file to ~/Library/LaunchAgents/
    4. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.nsls.person-intelligence-sweep.plist

  You no longer need to hardcode a python3.12 path — sweep_launchd_wrapper.sh finds the
  interpreter itself and records a real failure if it cannot.

  Verify without waiting for Sunday:
    launchctl kickstart -p gui/$(id -u)/com.nsls.person-intelligence-sweep
    tail -5 ~/.cache/person-intelligence/launchd.log
  A first run that logs "FRESH: ... skipping" is the freshness gate working correctly.

  Uninstall / pause:
    launchctl bootout gui/$(id -u)/com.nsls.person-intelligence-sweep
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.nsls.person-intelligence-sweep</string>

	<!-- Fires WEEKLY on Sunday. scheduled_sweep.py gates it down to biweekly via
	     sweep_due.py, because cron/launchd cannot express "every other Sunday"
	     (0/2 in the day-of-week field means Sun/Tue/Thu/Sat, not alternating).
	     06:47 rather than 07:00 so it isn't competing with every other
	     top-of-the-hour job on the machine. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>6</integer>
		<key>Minute</key>
		<integer>47</integer>
	</dict>

	<!-- Goes through sweep_launchd_wrapper.sh, NOT python directly.

	     The wrapper is the pre-Python guard. scheduled_sweep.py logs and records its own
	     failures, but anything that killed the job before Python started was invisible:
	     launchd appends raw child stderr to StandardErrorPath with no timestamp, nothing
	     reaches sweep-cron.log, and nothing is written to last-sweep-status.json — so no
	     skill surfaces it and no staleness signal fires.

	     That is not hypothetical. On 2026-08-09 and 2026-08-16 this plist invoked python
	     against a scheduled_sweep.py that had not shipped yet (it landed 2026-08-21). Both
	     Sundays died instantly with a bare, undated "can't open file" line, sweep-cron.log
	     showed a clean 21-day gap with no explanation, and the roster went 30 days stale
	     against a 12-day cadence while every dashboard reported healthy.

	     The plist and the scripts deploy independently, so the window where one exists
	     without the other recurs on every install, reinstall, branch switch, or partial
	     pull. The wrapper turns that window into a recorded, retried failure.

	     /bin/bash is explicit so this does not depend on PATH resolution. -->
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>/Users/YOUR_USERNAME/.claude/local-plugins/nsls-personal-toolkit/skills/person-intelligence/scripts/sweep_launchd_wrapper.sh</string>
	</array>

	<key>WorkingDirectory</key>
	<string>/Users/YOUR_USERNAME/nsls-skills/nsls-personal-toolkit</string>

	<!-- launchd starts with a minimal PATH that does NOT include ~/.local/bin,
	     where `claude` lives. Without this the sweep logs
	     "FAIL: claude not found on PATH". -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/Users/YOUR_USERNAME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>

	<key>StandardOutPath</key>
	<string>/Users/YOUR_USERNAME/.cache/person-intelligence/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOUR_USERNAME/.cache/person-intelligence/launchd.log</string>

	<key>RunAtLoad</key>
	<false/>
</dict>
</plist>
