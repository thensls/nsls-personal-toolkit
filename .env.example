# Personal Productivity Toolkit — Environment Variables
#
# EASIEST WAY: Just say "/setup" in Claude Code and it fills this in for you.
#
# Or copy this file to .env and fill in manually:
#   cp .env.example .env
#

# Builder identity (used by session tracking and automation registration)
BUILDER_EMAIL=you@nsls.org
GITHUB_USERNAME=your-github-username

# Your Slack user ID
# (Find it: click your profile pic in Slack → Profile → ⋮ → Copy member ID)
SLACK_USER_ID=

# Your Asana workspace and user GIDs
# (/setup auto-detects these if you have Asana connected)
ASANA_WORKSPACE_GID=
ASANA_USER_GID=

# Obsidian vault path (used by /open-day, /close-day, /close-week, /log)
# Common locations:
#   Local: ~/Obsidian/[initials]/
#   iCloud: ~/Library/Mobile Documents/iCloud~md~obsidian/Documents/[initials]/
OBSIDIAN_VAULT_PATH=

# Fathom API key (used by /close-day for meeting summaries, /person-intelligence for 1:1 transcripts)
# Get one at: https://fathom.video/settings/api
FATHOM_API_KEY=

# Airtable personal access token (only needed for /person-intelligence)
# Get one at: airtable.com/create/tokens
# Scopes needed: data.records:read, data.records:write, schema.bases:read
AIRTABLE_API_KEY=

# NSLS Airtable base IDs — these are already correct for all NSLS employees.
# Non-NSLS users: replace with your own base IDs.
PEOPLE_OPS_BASE_ID=appnXPTu01esWWbrK
SLT_BASE_ID=appHDEHQA4bvlWwQq
LOP_BASE_ID=appAcnl4o8AQVZR1j

# ─── Person Intelligence — biweekly sweep ──────────────────────────────────

# The email address that identifies "me" in the org chart.
# Used to look up your direct reports from the builder toolkit's org-chart.json.
# Defaults to BUILDER_EMAIL above if unset.
OPERATING_USER_EMAIL=

# Comma- or newline-separated names of people to track who aren't in the org chart
# (contractors, board members, family, key external collaborators).
# Each name should match what appears in your Obsidian 30-people/[Name].md files.
KEY_RELATIONSHIPS=

# Set to 1 to also track people who share your manager (your "peer ring").
# For SLT members this includes the rest of SLT.
# For an IC reporting to a manager, this includes your fellow ICs at the same level.
INCLUDE_MANAGEMENT_PEERS=

# Set to 1 to disable Slack ingest for the biweekly sweep, even if Slack MCP is connected.
SKIP_SLACK_INGEST=

# Set to 1 to disable Gmail ingest for the biweekly sweep, even if Gmail MCP is connected.
SKIP_GMAIL_INGEST=

# Patterns to skip during Slack/Gmail ingest. Comma-separated.
# Gmail: subject keyword regexes (e.g., "legal,payroll,severance")
# Slack: channel ID prefixes (e.g., "#hr-,#legal-")
# Defaults below cover common sensitive content; extend as needed.
INGEST_EXCLUDE_THREADS=legal,payroll,severance,hr-,#hr-,#legal-
