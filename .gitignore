.env
# Any sibling of .env holds the same three API keys. A bare `.env` rule matches that
# one filename and nothing else, so `.env.bak`, `.env.local` or a dated backup made
# while editing config is committable — which is exactly when one gets made.
# `.env.example` is the intended exception: it ships placeholders, never values.
.env.*
!.env.example
# Your personal harvest denylist — private by design, never shared to the template.
# Seed it from skills/harvest-meeting/references/harvest-exclude.example.txt
harvest-exclude.txt
.claude/settings.local.json
__pycache__/
*.pyc
*.egg-info/
.toolkit-state.json
.companion.pid
.companion-test.pid
.superpowers/

# Throwaway vault for `open day -t` / `close day -t` — never real data.
companion-test-vault/

# Per-machine companion build — created by install.sh / install.ps1, or on first
# use by companion/ensure-companion.sh. Never committed.
.venv/
companion/.install.log
companion/.install-failed
companion/.install.lock
