.env
# Your personal harvest denylist — private by design, never shared to the template.
# Seed it from skills/harvest-meeting/references/harvest-exclude.example.txt
harvest-exclude.txt
.claude/settings.local.json
__pycache__/
*.pyc
*.egg-info/
.toolkit-state.json
.companion.pid
.companion-test.pid
.superpowers/

# Throwaway vault for `open day -t` / `close day -t` — never real data.
companion-test-vault/

# Per-machine companion build — created by install.sh / install.ps1, or on first
# use by companion/ensure-companion.sh. Never committed.
.venv/
companion/.install.log
companion/.install-failed
companion/.install.lock
