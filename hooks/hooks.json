{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"${CLAUDE_PLUGIN_ROOT}\" pull --ff-only --quiet",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\" --no-pull || python \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.py\" --no-pull",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
